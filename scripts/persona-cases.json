{
  "_ghi_chu": "Bộ ca chấm người không rành kỹ thuật. Dân làng Trải nghiệm thêm ca bằng cách thêm một dòng vào cases (id không dấu, say là câu người thật gõ), không sửa code. Sửa danh sách chữ cấm ở forbidden. maxLines: điều (2), chỉ ca nào ghi mới chấm. allow: chữ cấm mà chính người dùng đã nói ra trong câu hỏi nên được nhắc lại.",
  "maxFirstTextSeconds": 15,
  "cases": [
    {
      "id": "chao-em",
      "say": "chào em",
      "maxLines": 4
    },
    {
      "id": "viec-truoc-nhat",
      "say": "việc nào chị cần làm trước nhất hôm nay?"
    },
    {
      "id": "co-gi-moi",
      "say": "Nếp có gì mới không em?"
    },
    {
      "id": "cap-nhat-giup",
      "say": "anh Sơn nhắn cập nhật Nếp, em làm giúp chị nha"
    },
    {
      "id": "may-dang-lam-gi",
      "say": "máy đang làm gì vậy, có bị lỗi không?"
    },
    {
      "id": "powershell-la-gi",
      "say": "PowerShell là gì?",
      "allow": [
        "PowerShell"
      ]
    },
    {
      "id": "khong-thay-ket-noi",
      "say": "chị không thấy mục Kết nối"
