      "flags": ""
    },
    {
      "label": "email công ty",
      "re": "email công ty",
      "flags": "i"
    }
  ],
  "english": {
    "_ghi_chu": "Một dòng có từ ba chữ khác nhau trở lên trong words (chữ không dấu, nguyên từ) thì tính là câu tiếng Anh.",
