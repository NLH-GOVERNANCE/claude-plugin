{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Plugin tinh-nlh (tỉnh NhiLe) is on. First turn of the session, before anything else: call my_context of the NhiLe Governance connector once (who the user is, their cells, open projects, work waiting, work assigned), then tell the user in plain Vietnamese what is waiting for them. If the user asks what they left unfinished, answer from that result without more lookups.\""
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "my_context",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "idle"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "save_chat",
            "input": {
              "session_id": "${session_id}",
              "role": "assistant",
              "text": "${last_assistant_message}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "stopped"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "save_chat",
            "input": {
              "session_id": "${session_id}",
              "role": "user",
              "text": "${prompt}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_tinh-nlh_nhile-governance__(?!my_context$)",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "working"
            }
          }
        ]
      }
    ]
  }
}
