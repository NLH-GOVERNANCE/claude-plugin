{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Plugin Nếp (nlh) is on. Call the system Nếp when talking to the user; the old name tỉnh NhiLe means the same. First turn of the session, before anything else: call my_context of the NhiLe Governance connector once (who the user is, their cells, open projects, work waiting, work assigned), then tell the user in plain Vietnamese what is waiting for them. If the user asks what they left unfinished, answer from that result without more lookups. Before any work, read village_rules in that result: the rules the whole village agreed, kept without being told again (no such field: get_cell luat-lang, file rules.md).\""
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/machine.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:nlh:nhile-governance",
            "tool": "my_context",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "idle"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:nlh:nhile-governance",
            "tool": "save_chat",
            "input": {
              "session_id": "${session_id}",
              "role": "assistant",
              "text": "${last_assistant_message}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "stopped"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:nlh:nhile-governance",
            "tool": "save_chat",
            "input": {
              "session_id": "${session_id}",
              "role": "user",
              "text": "${prompt}"
            },
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/correction.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_nlh_nhile-governance__(?!my_context$)",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "working"
            }
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit|billing_error",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "stopped",
              "machine_stop": "quota"
            },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
