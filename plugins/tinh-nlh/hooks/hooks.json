{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Plugin tinh-nlh (tỉnh NhiLe) đang bật. Đầu phiên, Claude gọi my_work của connector NhiLe Governance và tóm tắt việc đang chờ người dùng bằng lời thường trước khi làm việc khác.\""
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "idle"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "save_chat",
            "input": {
              "session_id": "${session_id}",
              "role": "assistant",
              "text": "${last_assistant_message}"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "stopped"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "save_chat",
            "input": {
              "session_id": "${session_id}",
              "role": "user",
              "text": "${prompt}"
            }
          }
        ]
      }
    ]
  }
}
