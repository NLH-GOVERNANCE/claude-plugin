{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Plugin tinh-nlh (tỉnh NhiLe) đang bật. Câu đầu của phiên, trước khi làm việc khác: gọi my_context của connector NhiLe Governance một lần (người dùng là ai, ô của họ, dự án đang dở, việc đang chờ, việc đã giao), rồi tóm tắt việc đang chờ người dùng bằng lời thường. Người dùng hỏi đang làm gì dở thì trả lời từ chính kết quả đó, không tra thêm.\""
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "my_context",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "idle"
            }
          },
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "save_chat",
            "input": {
              "session_id": "${session_id}",
              "role": "assistant",
              "text": "${last_assistant_message}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "stopped"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "save_chat",
            "input": {
              "session_id": "${session_id}",
              "role": "user",
              "text": "${prompt}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_tinh-nlh_nhile-governance__.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:tinh-nlh:nhile-governance",
            "tool": "report_session",
            "input": {
              "session_id": "${session_id}",
              "status": "working"
            }
          }
        ]
      }
    ]
  }
}
