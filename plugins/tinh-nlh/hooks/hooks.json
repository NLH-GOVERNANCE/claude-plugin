{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Plugin Nếp (nlh) is on. Call the system Nếp when talking to the user; the old name tỉnh NhiLe means the same. First turn of the session: do at once what the user asked; never make them wait for a lookup before the first words. Look up the Nếp context silently (my_context of the Nếp connector, in the same step as your first tool call or answer) and do not tell the user what is waiting before the answer. Only if there is work today that needs that very person to press, answer or sign (items marked for you, and to_sign; not plan_ready, not machine work), add exactly one line at the end, naming it by its title. If the user only greets, or asks hôm nay có gì, việc của tôi, đang dở gì: greet back in one sentence and name at most 3 items, the ones that need them first, one plain Vietnamese line each; no total count, no machine work, no codes, no technical words, no English. If asked what is new in Nếp: say the plugin version on this machine and 1 to 3 changes the user can see (skill nep, part What is new), never PR or repo news. In Claude Code the hooks already save every turn: do not call save_chat per turn, only role summary when a piece of work is done. Before any work, read village_rules in that result: the rules the whole village agreed, kept without being told again (no such field: get_cell luat-lang, file rules.md). If a Nếp tool fails with a sign-in error: call session_connectors_status if you have it (failed means reconnect_session_connector); otherwise follow the Nếp connector line printed at session start.\""
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/sign-in-check.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/machine.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/local-schedules-hook.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:nlh:nep",
            "tool": "my_context",
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "claude.ai Nếp",
            "tool": "my_context",
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "Nếp",
            "tool": "my_context",
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "claude.ai nhile-governance",
            "tool": "my_context",
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "nhile-governance",
            "tool": "my_context",
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "claude.ai NhiLe Governance",
            "tool": "my_context",
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "NhiLe Governance",
            "tool": "my_context",
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "3398cc99-b4dc-41bd-8007-bd4b6792d5cb",
            "tool": "my_context",
            "timeout": 30
          }
        ]
      }
